# GEMINI_API_KEY: Required for Gemini AI rationale generation (server-side only).
# Add your key here in .env or via the AI Studio Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TWELVEDATA_API_KEY: Required for Twelve Data NSE market quotes & candles (server-side only).
# Get a key at https://twelvedata.com and add it in .env.
TWELVEDATA_API_KEY=""

# DATA_PROVIDER: "twelvedata" (default when TWELVEDATA_API_KEY is set) or "yahoo"
DATA_PROVIDER="twelvedata"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
